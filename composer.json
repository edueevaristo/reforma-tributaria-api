{
    "name": "du-nf/reforma-tributaria",
    "description": "Biblioteca PHP open source para a Reforma Tributaria do Consumo (IBS, CBS e IS): cronograma de transicao, base de calculo, tabelas de CST e cClassTrib, calculo, grupos XML da NF-e/NFC-e e cliente da Calculadora de Tributos oficial da Receita Federal.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "reforma tributaria",
        "ibs",
        "cbs",
        "imposto seletivo",
        "nfe",
        "nfce",
        "lc 214",
        "cclasstrib",
        "psr-18"
    ],
    "homepage": "https://github.com/edueevaristo/reforma-tributaria-api",
    "authors": [
        {
            "name": "Eduardo Evaristo",
            "homepage": "https://github.com/edueevaristo"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "nyholm/psr7": "^1.8",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpunit/phpunit": "^9.6",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-curl": "Necessaria para usar o cliente da Calculadora de Tributos oficial com o transporte padrao.",
        "ext-pdo_sqlite": "Necessaria apenas para regenerar as tabelas com bin/atualizar-tabelas.php.",
        "psr/http-client": "Para usar o TransportePsr18 com Guzzle, Symfony HttpClient ou outro cliente PSR-18 (junto com psr/http-factory)."
    },
    "autoload": {
        "psr-4": {
            "DuNf\\ReformaTributaria\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DuNf\\ReformaTributaria\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable"
}
